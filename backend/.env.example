# Copy to backend/.env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
APP_TIME_ZONE=Asia/Riyadh

# --- Database (Supabase) ------------------------------------------------------
# Supabase dashboard → Connect → "Session pooler" (port 5432) works for both the app and migrations.
# The "Transaction pooler" (port 6543) also works for the app; use session/direct for `npm run db:migrate`.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# require = encrypted (default) | verify = encrypted + certificate check (set DATABASE_SSL_CA) | disable = local Postgres
DATABASE_SSL=require
# DATABASE_SSL_CA=./certs/prod-ca-2021.crt
DATABASE_POOL_MAX=10

# --- Auth ---------------------------------------------------------------------
# Sign-in methods (Microsoft, directory/LDAP, local passwords) are configured in the portal:
# Admin Settings → Sign-in & Directory.
# dev      = also show the pick-a-user development list (blocked when NODE_ENV=production)
# standard = only the methods switched on in Admin Settings (use this in test and production)
AUTH_MODE=dev
# openssl rand -base64 48
SESSION_SECRET=
SESSION_HOURS=8

# --- Field encryption (patient identifiers, via pgcrypto) ----------------------
# openssl rand -base64 32   — store in a secret manager; changing it makes existing identifiers unreadable.
FIELD_ENCRYPTION_KEY=

# --- Document storage ---------------------------------------------------------
# local = files under backend/storage (development) | supabase = private Supabase Storage bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=request-documents

# --- Email --------------------------------------------------------------------
# Normally configured in the portal: Admin Settings → Email (SMTP). These values are only the fallback
# used while that page is switched off.
# log = print emails to the console (development) | smtp = send
MAIL_TRANSPORT=log
MAIL_FROM="Holiday Dialysis Coordination <holiday.dialysis@example.com>"
MAIL_REPLY_TO=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Jobs ---------------------------------------------------------------------
# 0 = off (run `npm run jobs:reminders` from a scheduler instead)
REMINDER_INTERVAL_MINUTES=0
